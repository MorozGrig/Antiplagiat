# =============================================================================
# Внутренний реестр авторских материалов — пример конфигурации.
# Скопируйте в .env и заполните под своё окружение.
# =============================================================================

ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=registry
POSTGRES_USER=registry
POSTGRES_PASSWORD=registry
# Опционально — явные DSN (имеют приоритет над *_HOST/_PORT/...):
# DATABASE_URL=postgresql+asyncpg://registry:registry@localhost:5432/registry
# DATABASE_SYNC_URL=postgresql+psycopg2://registry:registry@localhost:5432/registry

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- S3 / MinIO --------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_FILES=materials
S3_BUCKET_CERTIFICATES=certificates

# --- Elasticsearch / Tika ----------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
TIKA_SERVER_URL=http://localhost:9998/tika

# --- Загрузка / антиплагиат --------------------------------------------------
MAX_FILE_SIZE=10485760            # 10 МБ (настраивается)
OCR_LANGUAGE=rus+eng
SIMILARITY_THRESHOLD_PERCENT=70.0

# --- JWT ---------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
